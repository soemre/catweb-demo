# Preferred: enable Web Analytics in the Cloudflare Pages dashboard and redeploy.
# Dashboard mode emits no source beacon. Actual activation needs a Cloudflare account.
PUBLIC_ANALYTICS_MODE=dashboard

# Optional manual setup, only when dashboard injection is disabled:
# PUBLIC_ANALYTICS_MODE=manual
# PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=<public site token from Web Analytics>

# Disable both the source loader and dashboard integration to turn tracking off:
# PUBLIC_ANALYTICS_MODE=off
