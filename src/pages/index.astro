---
import { getCollection } from 'astro:content';
import { pages, homeHero, getEvents, getNews } from '../lib/content';
import SiteLayout from '../layouts/SiteLayout.astro';
import RichText from '../components/RichText.astro';
import EventBrowser from '../components/EventBrowser.astro';
import NewsList from '../components/NewsList.astro';
import SupporterStrip from '../components/SupporterStrip.astro';
import HomeHero from '../components/HomeHero.astro';
import Icon from '../components/Icon.astro';
const page = pages.home;
const events = await getEvents();
const news = (await getNews()).slice(0, page.news.count);
const supporters = await getCollection('supporters');
const heroActive = homeHero.enabled && Boolean(homeHero.image);
---
<SiteLayout title={page.title} description={page.intro} seo={page.seo} image={heroActive ? homeHero.image : undefined}>
  <HomeHero hero={homeHero} headline={page.headline} safeSpace={page.safeSpace} slot="opening" />
  {!heroActive && <><h1 id="home-headline">{page.headline}</h1><p class="safe-space">{page.safeSpace}</p></>}
  <div class="home-introduction" data-home-introduction>
    <RichText text={page.intro} />
    <RichText text={page.invitations} />
  </div>
  {page.events.count > 0 && <section data-home-events>
    <div class="section-heading">
      <h2 id="home-events-heading">{page.events.heading}</h2>
      <a class="see-all" href={page.events.action.url} data-home-events-action aria-labelledby="home-events-see-all home-events-heading"><span id="home-events-see-all">{page.events.action.label}</span><Icon name="caret-right" /></a>
    </div>
    <RichText text={page.events.intro} />
    <EventBrowser entries={events} count={page.events.count} />
  </section>}
  {page.news.count > 0 && <section data-home-news>
    <div class="section-heading">
      <h2 id="home-news-heading">{page.news.heading}</h2>
      <a class="see-all" href={page.news.action.url} aria-labelledby="home-news-see-all home-news-heading"><span id="home-news-see-all">{page.news.action.label}</span><Icon name="caret-right" /></a>
    </div>
    <RichText text={page.news.intro} />
    <NewsList entries={news} home />
  </section>}
  <SupporterStrip entries={supporters} slot="full-width" />
</SiteLayout>
